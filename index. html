<!DOCTYPE html>
<html lang="gu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ALPHA-X | Quantum Institutional Terminal</title>
    <style>
        :root {
            --bg-base: #020408;
            --bg-card: #090e17;
            --border: #141c2b;
            --text-main: #f8fafc;
            --text-muted: #475569;
            --green: #10b981;
            --red: #f43f5e;
            --accent: #38bdf8;
            --gold: #f59e0b;
            --purple: #c084fc;
            --neon: #00f2fe;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            padding: 8px;
            font-size: 11px;
            padding-bottom: 60px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 8px;
        }
        .logo { font-weight: 900; font-size: 13px; color: var(--neon); letter-spacing: 0.5px; }
        .secure-badge { font-size: 8.5px; color: var(--green); background: rgba(16,185,129,0.1); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--green); }

        .tab-bar {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 2px;
            background: #060910;
            padding: 3px;
            border-radius: 6px;
            border: 1px solid var(--border);
            margin-bottom: 8px;
        }
        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 6px 1px;
            font-size: 8.5px;
            font-weight: 700;
            cursor: pointer;
            border-radius: 3px;
            text-align: center;
            white-space: nowrap;
        }
        .tab-btn.active {
            background: var(--border);
            color: var(--neon);
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 8px;
        }
        .card-title {
            color: var(--text-muted);
            font-size: 9.5px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px; }
        .metric-val { font-size: 15px; font-weight: bold; }
        
        .up { color: var(--green); }
        .down { color: var(--red); }
        .gold { color: var(--gold); }
        .purple { color: var(--purple); }
        .neon { color: var(--neon); }

        .input-group { margin-bottom: 4px; }
        label { font-size: 8.5px; color: var(--text-muted); text-transform: uppercase; }
        input, select, textarea {
            width: 100%;
            background: #03060a;
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 5px;
            border-radius: 4px;
            font-size: 10px;
            outline: none;
        }

        table { width: 100%; border-collapse: collapse; font-size: 9.5px; margin-top: 4px; }
        th { color: var(--text-muted); padding: 4px 2px; text-align: right; border-bottom: 1px solid var(--border); font-size: 8.5px; }
        th:first-child, td:first-child { text-align: left; }
        td { padding: 5px 2px; border-bottom: 1px solid rgba(255,255,255,0.03); text-align: right; }

        .btn-action {
            background: var(--neon);
            color: #000;
            border: none;
            padding: 6px;
            width: 100%;
            border-radius: 4px;
            font-weight: bold;
            font-size: 10px;
            cursor: pointer;
            margin-top: 5px;
        }

        canvas {
            width: 100%;
            height: 130px;
            background: #04070e;
            border-radius: 4px;
            border: 1px solid var(--border);
            margin-top: 4px;
        }

        .meter-wrap {
            height: 10px;
            background: #141c2b;
            border-radius: 3px;
            overflow: hidden;
            margin-top: 4px;
        }
        .meter-fill {
            height: 100%;
            transition: width 0.4s ease;
        }
    </style>
</head>
<body>

    <!-- Header -->
