    <!-- TAB 4: RBI SYSTEM LIQUIDITY & MACRO FUEL -->
    <div id="fuel-tab" class="tab-content">
        <div class="card">
            <div class="card-title">
                <span>RBI System Liquidity & Fuel Meter</span>
