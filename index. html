        </div>
    </div>

    <!-- TAB 5: QUANT GEX & SKEW GRAPH -->
    <div id="quant-tab" class="tab-content">
        <div class="card">
            <div class="card-title">
                <span>Volatility Skew Canvas</span>
                <span class="purple">Live Smile Curve</span>
            </div>
            <canvas id="quantumCanvas"></canvas>
            <div class="grid-2" style="margin-top:6px;">
                <div style="text-align:center;">
                    <span style="font-size:8px; color:var(--text-muted);">ZERO GAMMA FLIP</span>
